{
  "name": "vidya-mitra-monorepo",
  "version": "1.0.0",
  "description": "Vidya Mitra — AI-powered Socratic Tutor & Parent Bridge for Classes 1 to 8",
  "private": true,
  "scripts": {
    "mobile:start": "cd mobile-app && npm start",
    "mobile:android": "cd mobile-app && npm run android",
    "mobile:ios": "cd mobile-app && npm run ios",
    "ai:dev": "cd ai-service && uvicorn app.main:app --reload --port 8000",
    "backend:dev": "cd backend && ./mvnw spring-boot:run",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "train:gen-data": "cd ml-training && python dataset_generator/generate_socratic_ncert_dataset.py"
  },
  "keywords": [
    "education",
    "indic-languages",
    "rag",
    "socratic-tutor",
    "ncert",
    "react-native",
    "spring-boot",
    "fastapi",
    "phi-3",
    "nemotron",
    "gemma"
  ],
  "author": "Sain",
  "license": "MIT"
}
